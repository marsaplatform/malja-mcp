{
  "mcpServers": {
    "malja": {
      "command": "node",
      "args": ["/absolute/path/to/malja-mcp/dist/index.js"],
      "env": {
        "MALJA_CACHE": "sqlite",
        "MALJA_CACHE_PATH": "/absolute/path/to/malja-mcp/.cache/malja.sqlite",
        "MALJA_LOG_LEVEL": "info"
      }
    }
  }
}
